datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id                   String   @id @default(uuid())
  slug                 String   @unique
  name                 String
  shortDescription     String
  description          String
  repositoryUrl        String
  liveUrl              String?
  logoUrl              String?
  previewImageUrl      String?
  previewVideoUrl      String?
  category             String
  technologies         String[]
  featured             Boolean  @default(false)
  status               String   @default("IN_DEVELOPMENT") // IN_DEVELOPMENT, LIVE, ARCHIVED
  displayOrder         Int      @default(0)
  
  // Advanced fields
  problem              String?
  solution             String?
  architecture         String?
  engineeringDecisions String[]
  challenges           String[]
  results              String[]
  apiDocumentationUrl  String?
  caseStudyEnabled     Boolean  @default(false)
  githubMetadata       Json?
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
