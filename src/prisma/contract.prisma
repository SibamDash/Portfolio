model Project {
  id                   String   @id @default(uuid())
  slug                 String   @unique
  name                 String
  shortDescription     String
  description          String
  repositoryUrl        String
  liveUrl              String?
  logoUrl              String?
  previewImageUrl      String?
  previewVideoUrl      String?
  category             String
  technologies         String[]
  featured             Boolean  @default(false)
  status               String   @default("IN_DEVELOPMENT")
  displayOrder         Int      @default(0)
  
  // Advanced fields
  problem              String?
  solution             String?
  architecture         String?
  architectureNodes    Json?
  engineeringDecisions String[]
  challenges           String[]
  results              String[]
  apiDocumentationUrl  String?
  caseStudyEnabled     Boolean  @default(false)
  githubMetadata       Json?
  
  createdAt            TimestamptzString @default(now())
  updatedAt            temporal.updatedAtString()
}
